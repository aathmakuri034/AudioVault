# Local development defaults. Copy to .env (gitignored) and fill in.
# EXPO_PUBLIC_* values are embedded in the JS bundle: use them for local
# development only. In-app Settings override these and store the key in the
# device keychain.

# Your computer's LAN address where `docker compose up` exposes the backend.
# The iOS Simulator can also use http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Must match API_KEY in backend/.env
EXPO_PUBLIC_API_KEY=
