# Copy to .env and edit. Every setting below is optional except API_KEY.

# REQUIRED. Shared secret the app sends in the X-API-Key header.
# Generate one with: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# Comma-separated providers to enable. Remove "youtube" to disable it without code changes.
ENABLED_PROVIDERS=youtube

# Where temporary MP3s are written. Purged on every startup. (Docker image uses /app/tmp.)
TEMP_DIR=./tmp

# Reject media longer than this many seconds (default 30 minutes).
MAX_DURATION_SECONDS=1800

# Jobs converting at the same time, and jobs allowed to wait (more -> 503 server_busy).
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20

# Finished/failed jobs and their files are deleted this many seconds after they finish.
JOB_TTL_SECONDS=1800

# Hard limit for a single job (download + conversion), in seconds.
JOB_TIMEOUT_SECONDS=600

# MP3 bitrate in kbps.
MP3_BITRATE_KBPS=192

# Rate limits per client IP, slowapi syntax ("N/second|minute|hour").
METADATA_RATE_LIMIT=30/minute
DOWNLOAD_RATE_LIMIT=10/minute

# Reject request bodies larger than this many bytes.
MAX_REQUEST_BYTES=4096

# Network timeout for yt-dlp, in seconds.
SOCKET_TIMEOUT_SECONDS=20

# JavaScript runtime yt-dlp uses for YouTube: deno (Docker default) or node (handy locally).
YTDLP_JS_RUNTIME=deno

# Optional: directory or path of the FFmpeg binary if it is not on PATH.
# FFMPEG_LOCATION=/usr/local/bin

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
